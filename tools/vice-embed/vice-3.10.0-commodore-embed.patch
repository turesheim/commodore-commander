diff --git a/src/arch/sdl/cc_command_reader.c b/src/arch/sdl/cc_command_reader.c
new file mode 100644
--- /dev/null
+++ b/src/arch/sdl/cc_command_reader.c
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc_command_reader.h"
+#ifdef _WIN32
+#include <windows.h>
+int cc_command_read(int fd, char *buffer, unsigned int capacity)
+{
+    HANDLE pipe;
+    DWORD available, count;
+    /* Node provides a standard Windows pipe, not a CRT fd 3. */
+    if (fd != 0) { return -1; }
+    pipe = GetStdHandle(STD_INPUT_HANDLE);
+    if (!PeekNamedPipe(pipe, NULL, 0, NULL, &available, NULL)) {
+        return GetLastError() == ERROR_BROKEN_PIPE ? 0 : -1;
+    }
+    if (!available) { return 0; }
+    if (available > capacity) { available = capacity; }
+    if (!ReadFile(pipe, buffer, available, &count, NULL)) {
+        return GetLastError() == ERROR_BROKEN_PIPE ? 0 : -1;
+    }
+    return (int)count;
+}
+#else
+#include <errno.h>
+#include <unistd.h>
+int cc_command_read(int fd, char *buffer, unsigned int capacity)
+{
+    ssize_t count = read(fd, buffer, capacity);
+    if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+        return 0;
+    }
+    return (int)count;
+}
+#endif
