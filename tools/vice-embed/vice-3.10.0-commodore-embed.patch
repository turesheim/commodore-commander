+#define CC_EMBED_FLAG "-cc-embed"
+#define CC_EMBED_FRAME_PORT_FLAG "-cc-frame-port"
+#define CC_EMBED_COMMAND_FD_FLAG "-cc-command-fd"
+#define CC_EMBED_PREFIX "CCV1 "
+#define CC_EMBED_PROTOCOL "commodore-vice-embed-v1"
+#define CC_EMBED_LINE_BYTES 4096
+#define CC_EMBED_BINARY_MAGIC "CCB1"
+#define CC_EMBED_BINARY_HEADER_BYTES 32
+#define CC_EMBED_BINARY_FRAME_TYPE_RGBA8888 1
+#define CC_EMBED_BINARY_PIXEL_FORMAT_RGBA8888 1
+#define CC_EMBED_MIN_FRAME_INTERVAL_MS 16
+#define CC_EMBED_FRAME_SOCKET_SEND_BUFFER_BYTES (4 * 1024 * 1024)
+#define CC_EMBED_FRAME_SOCKET_BACKLOG_LIMIT_BYTES (2 * 1024 * 1024)
+#define CC_EMBED_MATRIX_SHIFT_KEY SDLK_RSHIFT
+#define CC_EMBED_C64_MATRIX_ROWS 8
+#define CC_EMBED_C64_MATRIX_COLS 8
+
+static int cc_embed_enabled = 0;
+static int cc_embed_frame_port = 0;
+static int cc_embed_command_fd = 0;
+static cc_socket_t cc_embed_frame_socket = CC_INVALID_SOCKET;
+#ifdef _WIN32
+static int cc_embed_winsock_started = 0;
+#endif
+static cc_frame_writer_t cc_embed_frame_writer;
+static uint32_t cc_embed_frame_id = 0;
+static uint32_t cc_embed_last_frame_ticks = 0;
+static int cc_embed_force_next_frame = 0;
+static int cc_embed_skip_current_frame = 0;
+static char cc_embed_line[CC_EMBED_LINE_BYTES];
+static size_t cc_embed_line_len = 0;
+static int cc_embed_matrix_shift_count = 0;
+static int cc_embed_matrix_key_down[CC_EMBED_C64_MATRIX_ROWS][CC_EMBED_C64_MATRIX_COLS];
+static int cc_embed_matrix_key_shift_down[CC_EMBED_C64_MATRIX_ROWS][CC_EMBED_C64_MATRIX_COLS];
+
+static void cc_embed_emit_hello(void);
+static void cc_embed_emit_status(const char *state, const char *message);
+static void cc_embed_set_fd_nonblocking(int fd);
+static int cc_embed_read_commands(void);
+static void cc_embed_connect_frame_socket(void);
+static void cc_embed_close_frame_socket(void);
+static int cc_embed_should_use_frame_socket(void);
+static int cc_embed_frame_socket_connected(void);
+static int cc_embed_frame_socket_accepts_frame(size_t frame_length);
+static void cc_embed_handle_line(const char *line);
+static void cc_embed_handle_key(const char *payload);
+static void cc_embed_handle_mouse(const char *payload);
+static void cc_embed_push_sdl_key(SDLKey key, SDLMod mod, int pressed);
+static int cc_embed_apply_matrix_key(SDLKey key,
+                                     SDLMod mod,
+                                     int row,
+                                     int col,
+                                     int shift,
+                                     int pressed);
+static void cc_embed_set_matrix_shift(int pressed);
+static void cc_embed_apply_mouse_motion(int xrel, int yrel);
+static void cc_embed_apply_mouse_button(int button, int pressed);
