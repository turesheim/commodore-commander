+                                       uint64_t timestamp_ms,
+                                       uint16_t width,
+                                       uint16_t height,
+                                       const uint8_t *payload,
+                                       size_t payload_length);
+static void cc_embed_write_binary_frame_header(uint8_t *header,
+                                               uint32_t frame_id,
+                                               uint64_t timestamp_ms,
+                                               uint16_t width,
+                                               uint16_t height,
+                                               uint32_t payload_length);
+static int cc_embed_write_frame_bytes(const void *buffer, size_t length);
