+static int cc_embed_json_int(const char *json, const char *name, int *value);
+static int cc_embed_json_has_string(const char *json, const char *name, const char *value);
+static SDLKey cc_embed_dom_key_to_sdl(int key_code, const char *payload);
+static uint32_t cc_embed_get_pixel(const uint8_t *row, int x, const SDL_PixelFormat *format);
+static int cc_embed_write_binary_frame(uint32_t frame_id,
+                                       uint64_t timestamp_ms,
+                                       uint16_t width,
+                                       uint16_t height,
+                                       const uint8_t *payload,
+                                       size_t payload_length);
+static void cc_embed_write_binary_frame_header(uint8_t *header,
+                                               uint32_t frame_id,
+                                               uint64_t timestamp_ms,
+                                               uint16_t width,
+                                               uint16_t height,
+                                               uint32_t payload_length);
+static int cc_embed_write_frame_bytes(const void *buffer, size_t length);
+static void cc_embed_write_u16_le(uint8_t *target, uint16_t value);
+static void cc_embed_write_u32_le(uint8_t *target, uint32_t value);
+static void cc_embed_write_u64_le(uint8_t *target, uint64_t value);
+
+void cc_embed_init_from_args(int *argc, char ***argv)
+{
+    int source;
+    int target;
+    char **args;
+
+    if (argc == NULL || argv == NULL || *argv == NULL) {
+        return;
+    }
+
+    args = *argv;
+    target = 1;
+    for (source = 1; source < *argc; source++) {
+        if (strcmp(args[source], CC_EMBED_FLAG) == 0) {
+            cc_embed_enabled = 1;
+            continue;
+        }
+        if (strcmp(args[source], CC_EMBED_FRAME_PORT_FLAG) == 0) {
+            if (source + 1 < *argc) {
+                char *endptr;
+                long parsed_port = strtol(args[source + 1], &endptr, 10);
+                if (endptr != args[source + 1] &&
+                    parsed_port > 0 &&
+                    parsed_port <= 65535) {
+                    cc_embed_frame_port = (int)parsed_port;
+                }
+                source++;
+            }
+            continue;
+        }
+        if (strcmp(args[source], CC_EMBED_COMMAND_FD_FLAG) == 0) {
+            if (source + 1 < *argc) {
+                char *endptr;
+                long parsed_fd = strtol(args[source + 1], &endptr, 10);
+                if (endptr != args[source + 1] &&
+                    parsed_fd >= 0 &&
+                    parsed_fd <= 255) {
+                    cc_embed_command_fd = (int)parsed_fd;
+                }
+                source++;
+            }
+            continue;
+        }
+        args[target++] = args[source];
+    }
+    args[target] = NULL;
+    *argc = target;
+
+    if (!cc_embed_enabled) {
+        return;
+    }
+
+    setvbuf(stdout, NULL, _IONBF, 0);
+    cc_embed_set_fd_nonblocking(cc_embed_command_fd);
+    cc_embed_connect_frame_socket();
+    cc_embed_emit_hello();
+    if (cc_embed_should_use_frame_socket() && !cc_embed_frame_socket_connected()) {
+        cc_embed_emit_status("error", "Frame socket transport unavailable.");
+    } else {
+        cc_embed_emit_status("running", "Frame transport enabled.");
+    }
+}
+
+int cc_embed_is_enabled(void)
+{
+    return cc_embed_enabled;
+}
+
+void cc_embed_poll_commands(void)
+{
+    /* Advance a partial record without blocking the SDL/input loop. */
+    if (cc_embed_frame_socket != CC_INVALID_SOCKET &&
+        cc_frame_writer_flush(&cc_embed_frame_writer, cc_embed_frame_socket) < 0) {
+        cc_embed_close_frame_socket();
+        cc_embed_emit_status("error", "Could not write embedded frame socket.");
+    }
+    (void)cc_embed_read_commands();
+}
+
+static int cc_embed_read_commands(void)
+{
+    char buffer[512];
+    int count;
+    int index;
+    int read_any = 0;
+
+    if (!cc_embed_enabled) {
+        return 0;
+    }
+
+    for (;;) {
+        count = cc_command_read(cc_embed_command_fd, buffer, sizeof(buffer));
+        if (count < 0) {
+            cc_embed_emit_status("error", "Could not read embedded input stream.");
+            return read_any;
+        }
+        if (count == 0) {
+            return read_any;
+        }
+        read_any = 1;
+
+        for (index = 0; index < count; index++) {
+            char c = buffer[index];
+            if (c == '\n') {
+                cc_embed_line[cc_embed_line_len] = '\0';
+                cc_embed_handle_line(cc_embed_line);
+                cc_embed_line_len = 0;
+            } else if (cc_embed_line_len + 1 < sizeof(cc_embed_line)) {
+                cc_embed_line[cc_embed_line_len++] = c;
+            } else {
+                cc_embed_line_len = 0;
+                cc_embed_emit_status("error", "Embedded input line was too long.");
+            }
+        }
+    }
+}
+
+void cc_embed_publish_frame(int width,
+                            int height,
+                            const void *pixels,
+                            int pitch,
+                            const SDL_PixelFormat *format)
+{
+    const uint8_t *source;
+    uint8_t *rgba;
+    uint8_t *target;
+    int x;
+    int y;
+    uint32_t now;
+    size_t length;
+
+    if (!cc_embed_enabled || pixels == NULL || format == NULL) {
+        return;
+    }
+    if (width <= 0 || height <= 0 || width > 2048 || height > 2048) {
+        return;
+    }
+    if (cc_embed_skip_current_frame) {
+        cc_embed_skip_current_frame = 0;
+        return;
+    }
+    now = SDL_GetTicks();
+    if (!cc_embed_force_next_frame && cc_embed_frame_id > 0) {
+        if ((uint32_t)(now - cc_embed_last_frame_ticks) < CC_EMBED_MIN_FRAME_INTERVAL_MS) {
+            return;
+        }
+    }
+    cc_embed_force_next_frame = 0;
+    cc_embed_last_frame_ticks = now;
+
+    length = (size_t)width * (size_t)height * 4;
+    rgba = (uint8_t *)malloc(length);
+    if (rgba == NULL) {
+        cc_embed_emit_status("error", "Could not allocate embedded frame buffer.");
+        return;
+    }
+
+    target = rgba;
+    source = (const uint8_t *)pixels;
+    for (y = 0; y < height; y++) {
+        const uint8_t *row = source + (pitch * y);
+        for (x = 0; x < width; x++) {
+            uint8_t r;
+            uint8_t g;
+            uint8_t b;
+            uint8_t a;
+            uint32_t pixel = cc_embed_get_pixel(row, x, format);
+            SDL_GetRGBA(pixel, format, &r, &g, &b, &a);
+            *target++ = r;
+            *target++ = g;
+            *target++ = b;
+            *target++ = a;
+        }
+    }
+
+    cc_embed_frame_id++;
+    (void)cc_embed_write_binary_frame(
+        cc_embed_frame_id,
+        (uint64_t)now,
+        (uint16_t)width,
+        (uint16_t)height,
+        rgba,
+        length);
+    free(rgba);
+}
+
+void cc_embed_shutdown(void)
+{
+    if (!cc_embed_enabled) {
+        return;
+    }
+    cc_embed_emit_status("stopped", "Frame transport stopped.");
+    cc_embed_close_frame_socket();
+}
+
+static void cc_embed_emit_hello(void)
+{
+    printf(CC_EMBED_PREFIX
+           "{\"type\":\"hello\",\"protocol\":\"%s\",\"machine\":\"sdl\"}\n",
+           CC_EMBED_PROTOCOL);
+}
+
+static void cc_embed_emit_status(const char *state, const char *message)
+{
+    printf(CC_EMBED_PREFIX
+           "{\"type\":\"status\",\"state\":\"%s\",\"message\":\"%s\"}\n",
+           state,
+           message);
+}
+
+static void cc_embed_set_fd_nonblocking(int fd)
+{
+#ifndef WINDOWS_COMPILE
+    int flags = fcntl(fd, F_GETFL, 0);
+    if (flags >= 0) {
+        (void)fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+    }
+#endif
+}
+
+static void cc_embed_connect_frame_socket(void)
+{
+    struct sockaddr_in address;
+    cc_socket_t socket_fd;
+    int send_buffer_bytes = CC_EMBED_FRAME_SOCKET_SEND_BUFFER_BYTES;
+#ifdef SO_NOSIGPIPE
+    int no_sigpipe = 1;
+#endif
+
+    if (!cc_embed_should_use_frame_socket() || cc_embed_frame_socket != CC_INVALID_SOCKET) {
+        return;
+    }
+
+#ifdef _WIN32
+    if (!cc_embed_winsock_started) {
+        WSADATA data;
+        if (WSAStartup(MAKEWORD(2, 2), &data) != 0) {
+            cc_embed_emit_status("error", "Could not initialize embedded Winsock transport.");
+            return;
+        }
+        cc_embed_winsock_started = 1;
+    }
+#endif
+    socket_fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (socket_fd == CC_INVALID_SOCKET) {
+        cc_embed_emit_status("error", "Could not create embedded frame socket.");
+        return;
+    }
+
+    (void)setsockopt(socket_fd,
+                     SOL_SOCKET,
+                     SO_SNDBUF,
+                     (const char *)&send_buffer_bytes,
+                     sizeof(send_buffer_bytes));
+#ifdef SO_NOSIGPIPE
+    (void)setsockopt(socket_fd,
+                     SOL_SOCKET,
+                     SO_NOSIGPIPE,
+                     (const char *)&no_sigpipe,
+                     sizeof(no_sigpipe));
+#endif
+
+    memset(&address, 0, sizeof(address));
+    address.sin_family = AF_INET;
+    address.sin_port = htons((uint16_t)cc_embed_frame_port);
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+    if (connect(socket_fd, (const struct sockaddr *)&address, sizeof(address)) != 0) {
+        cc_socket_close(socket_fd);
+        cc_embed_emit_status("error", "Could not connect embedded frame socket.");
+        return;
+    }
+
+    cc_embed_frame_socket = socket_fd;
+#ifdef _WIN32
+    {
+        u_long nonblocking = 1;
+        if (ioctlsocket(cc_embed_frame_socket, FIONBIO, &nonblocking) != 0) {
+            cc_embed_close_frame_socket();
+            cc_embed_emit_status("error", "Could not make embedded frame socket nonblocking.");
+        }
+    }
+#else
+    cc_embed_set_fd_nonblocking(cc_embed_frame_socket);
+#endif
+}
+
+static void cc_embed_close_frame_socket(void)
+{
+    cc_frame_writer_reset(&cc_embed_frame_writer);
+    if (cc_embed_frame_socket != CC_INVALID_SOCKET) {
+        cc_socket_close(cc_embed_frame_socket);
+        cc_embed_frame_socket = CC_INVALID_SOCKET;
+    }
+#ifdef _WIN32
+    if (cc_embed_winsock_started) {
+        WSACleanup();
+        cc_embed_winsock_started = 0;
+    }
+#endif
+}
+
+static int cc_embed_should_use_frame_socket(void)
+{
+    return cc_embed_frame_port > 0;
+}
+
+static int cc_embed_frame_socket_connected(void)
+{
+    return cc_embed_frame_socket != CC_INVALID_SOCKET;
+}
+
+static void cc_embed_handle_line(const char *line)
+{
+    const char *payload;
+
+    if (strncmp(line, CC_EMBED_PREFIX, strlen(CC_EMBED_PREFIX)) != 0) {
+        return;
+    }
+
+    payload = line + strlen(CC_EMBED_PREFIX);
+    if (strstr(payload, "\"type\":\"key\"") != NULL) {
+        cc_embed_handle_key(payload);
+    } else if (strstr(payload, "\"type\":\"mouse\"") != NULL) {
+        cc_embed_handle_mouse(payload);
+    } else if (strstr(payload, "\"type\":\"reset\"") != NULL) {
+        machine_trigger_reset(MACHINE_RESET_MODE_RESET_CPU);
+        cc_embed_emit_status("running", "Reset requested.");
+    } else if (strstr(payload, "\"type\":\"menu\"") != NULL) {
+        cc_embed_last_frame_ticks = 0;
+        cc_embed_force_next_frame = 1;
+        cc_embed_skip_current_frame = 1;
+        sdl_ui_activate();
+        cc_embed_emit_status("running", "Menu requested.");
+    } else if (strstr(payload, "\"type\":\"quit\"") != NULL) {
+        cc_embed_emit_status("stopped", "Quit requested.");
+        exit(0);
+    }
+}
+
+static void cc_embed_handle_key(const char *payload)
+{
+    int key_code = 0;
+    int sdl_key_code = 0;
+    int use_sdl_key_code = 0;
+    int use_key_code = 0;
+    int matrix_row = -1;
+    int matrix_col = -1;
+    int matrix_shift = 0;
+    int use_matrix_key = 0;
+    int pressed = 0;
+    int modifier = 0;
+    SDLKey key;
+    SDLMod mod = KMOD_NONE;
+
+    use_sdl_key_code = cc_embed_json_int(payload, "\"sdlKeyCode\"", &sdl_key_code);
+    use_key_code = cc_embed_json_int(payload, "\"keyCode\"", &key_code);
+    use_matrix_key = cc_embed_json_int(payload, "\"matrixRow\"", &matrix_row) &&
+                     cc_embed_json_int(payload, "\"matrixCol\"", &matrix_col);
+    if (!use_sdl_key_code && !use_key_code && !use_matrix_key) {
+        return;
+    }
+    if (!cc_embed_json_bool(payload, "\"pressed\"", &pressed)) {
+        return;
+    }
+    if (!cc_embed_json_bool(payload, "\"matrixShift\"", &matrix_shift)) {
+        matrix_shift = 0;
+    }
+
+    key = SDLK_UNKNOWN;
+    if (use_sdl_key_code) {
+        key = (SDLKey)sdl_key_code;
+    } else if (use_key_code) {
+        key = cc_embed_dom_key_to_sdl(key_code, payload);
+    }
+
+    if (cc_embed_json_bool_or_fallback(payload,
+                                       use_sdl_key_code ? "\"sdlShift\"" : NULL,
+                                       "\"shift\"",
+                                       &modifier) && modifier) {
+        mod |= KMOD_LSHIFT;
+    }
+    if (cc_embed_json_bool_or_fallback(payload,
+                                       use_sdl_key_code ? "\"sdlCtrl\"" : NULL,
+                                       "\"ctrl\"",
+                                       &modifier) && modifier) {
+        mod |= KMOD_LCTRL;
+    }
+    if (cc_embed_json_bool_or_fallback(payload,
+                                       use_sdl_key_code ? "\"sdlAlt\"" : NULL,
+                                       "\"alt\"",
+                                       &modifier) && modifier) {
+        mod |= KMOD_LALT;
+    }
+
+    if (sdl_menu_state) {
+        if (key != SDLK_UNKNOWN) {
+            cc_embed_push_sdl_key(key, mod, pressed);
+        }
+        return;
+    }
+
+    if (key == SDLK_UNKNOWN) {
+        return;
+    }
+
+    if (use_matrix_key &&
+        cc_embed_apply_matrix_key(key, mod, matrix_row, matrix_col, matrix_shift, pressed)) {
+        return;
+    }
+
+    if (pressed) {
+        sdlkbd_press(key, mod);
+    } else {
+        sdlkbd_release(key, mod);
+    }
+}
+
+static void cc_embed_handle_mouse(const char *payload)
+{
+    int xrel = 0;
+    int yrel = 0;
+    int button = 0;
+    int pressed = 0;
+
+    (void)cc_embed_json_int(payload, "\"xRel\"", &xrel);
+    (void)cc_embed_json_int(payload, "\"yRel\"", &yrel);
+    if (xrel != 0 || yrel != 0) {
+        cc_embed_apply_mouse_motion(xrel, yrel);
+    }
+
+    if (cc_embed_json_int(payload, "\"button\"", &button) &&
+        cc_embed_json_bool(payload, "\"pressed\"", &pressed) &&
+        button > 0 &&
+        button <= 255) {
+        cc_embed_apply_mouse_button(button, pressed);
+    }
+}
+
+static void cc_embed_push_sdl_key(SDLKey key, SDLMod mod, int pressed)
+{
+    SDL_Event event;
+
+    memset(&event, 0, sizeof(event));
+    event.type = pressed ? SDL_KEYDOWN : SDL_KEYUP;
+    event.key.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+    event.key.keysym.sym = SDL1x_to_SDL2x_Keys(key);
+    event.key.keysym.mod = mod;
+    SDL_PushEvent(&event);
+}
+
+static int cc_embed_apply_matrix_key(SDLKey key,
+                                     SDLMod mod,
+                                     int row,
+                                     int col,
+                                     int shift,
+                                     int pressed)
+{
+    int had_shift;
+
+    if (row < 0 || row >= CC_EMBED_C64_MATRIX_ROWS ||
+        col < 0 || col >= CC_EMBED_C64_MATRIX_COLS) {
+        return 0;
+    }
+
+    shift = shift ? 1 : 0;
+    if (pressed) {
+        if (!cc_embed_matrix_key_down[row][col]) {
+            cc_embed_matrix_key_down[row][col] = 1;
+            cc_embed_matrix_key_shift_down[row][col] = shift;
+            if (shift && cc_embed_matrix_shift_count++ == 0) {
+                cc_embed_set_matrix_shift(1);
+            }
+        } else if (shift && !cc_embed_matrix_key_shift_down[row][col]) {
+            cc_embed_matrix_key_shift_down[row][col] = 1;
+            if (cc_embed_matrix_shift_count++ == 0) {
+                cc_embed_set_matrix_shift(1);
+            }
+        }
+        cc_embed_push_sdl_key(key, mod, 1);
+        return 1;
+    }
+
+    had_shift = cc_embed_matrix_key_shift_down[row][col];
+    cc_embed_matrix_key_down[row][col] = 0;
+    cc_embed_matrix_key_shift_down[row][col] = 0;
+    cc_embed_push_sdl_key(key, mod, 0);
+    if (had_shift && cc_embed_matrix_shift_count > 0 &&
+        --cc_embed_matrix_shift_count == 0) {
+        cc_embed_set_matrix_shift(0);
+    }
+    return 1;
+}
+
+static void cc_embed_set_matrix_shift(int pressed)
+{
+    cc_embed_push_sdl_key(CC_EMBED_MATRIX_SHIFT_KEY, KMOD_NONE, pressed);
+}
+
+static void cc_embed_apply_mouse_motion(int xrel, int yrel)
+{
+    if (_mouse_enabled) {
+        mouse_move((float)xrel, (float)yrel);
+    }
+}
+
+static void cc_embed_apply_mouse_button(int button, int pressed)
+{
+    if (_mouse_enabled) {
+        mouse_button(button, pressed);
+    }
+}
+
+static int cc_embed_json_bool(const char *json, const char *name, int *value)
+{
+    const char *position = strstr(json, name);
+    if (position == NULL) {
+        return 0;
+    }
+    position = strchr(position, ':');
+    if (position == NULL) {
+        return 0;
+    }
+    position++;
+    while (isspace((unsigned char)*position)) {
+        position++;
+    }
+    if (strncmp(position, "true", 4) == 0) {
+        *value = 1;
+        return 1;
+    }
+    if (strncmp(position, "false", 5) == 0) {
+        *value = 0;
+        return 1;
+    }
+    return 0;
+}
+
+static int cc_embed_json_bool_or_fallback(const char *json,
+                                         const char *primary_name,
+                                         const char *fallback_name,
+                                         int *value)
+{
+    if (primary_name != NULL && cc_embed_json_bool(json, primary_name, value)) {
+        return 1;
+    }
+    return cc_embed_json_bool(json, fallback_name, value);
+}
+
+static int cc_embed_json_int(const char *json, const char *name, int *value)
+{
+    char *endptr;
+    long parsed;
+    const char *position = strstr(json, name);
+    if (position == NULL) {
+        return 0;
+    }
+    position = strchr(position, ':');
+    if (position == NULL) {
+        return 0;
+    }
+    parsed = strtol(position + 1, &endptr, 10);
+    if (endptr == position + 1) {
+        return 0;
+    }
+    *value = (int)parsed;
+    return 1;
+}
+
+static int cc_embed_json_has_string(const char *json, const char *name, const char *value)
+{
+    char pattern[128];
+    if (strlen(name) + strlen(value) + 6 >= sizeof(pattern)) {
+        return 0;
+    }
+    sprintf(pattern, "%s:\"%s\"", name, value);
+    return strstr(json, pattern) != NULL;
+}
+
+static SDLKey cc_embed_dom_key_to_sdl(int key_code, const char *payload)
+{
+    if (key_code >= 'A' && key_code <= 'Z') {
+        return (SDLKey)('a' + (key_code - 'A'));
+    }
+    if (key_code >= '0' && key_code <= '9') {
+        return (SDLKey)key_code;
+    }
+
+    switch (key_code) {
+        case 8:
+            return SDLK_BACKSPACE;
+        case 9:
+            return SDLK_TAB;
+        case 13:
+            return SDLK_RETURN;
+        case 27:
+            return SDLK_ESCAPE;
+        case 32:
+            return SDLK_SPACE;
+        case 37:
+            return SDLK_LEFT;
+        case 38:
+            return SDLK_UP;
+        case 39:
+            return SDLK_RIGHT;
+        case 40:
+            return SDLK_DOWN;
+        case 46:
+            return SDLK_DELETE;
+        case 112:
+            return SDLK_F1;
+        case 113:
+            return SDLK_F2;
+        case 114:
+            return SDLK_F3;
+        case 115:
+            return SDLK_F4;
+        case 116:
+            return SDLK_F5;
+        case 117:
+            return SDLK_F6;
+        case 118:
+            return SDLK_F7;
+        case 119:
+            return SDLK_F8;
+        case 120:
+            return SDLK_F9;
+        case 121:
+            return SDLK_F10;
+        case 122:
+            return SDLK_F11;
+        case 123:
+            return SDLK_F12;
+        case 186:
+            return (SDLKey)';';
+        case 187:
+            return (SDLKey)'=';
+        case 188:
+            return (SDLKey)',';
+        case 189:
+            return (SDLKey)'-';
+        case 190:
+            return (SDLKey)'.';
+        case 191:
+            return (SDLKey)'/';
+        case 192:
+            return (SDLKey)'`';
+        case 219:
+            return (SDLKey)'[';
+        case 220:
+            return (SDLKey)'\\';
+        case 221:
+            return (SDLKey)']';
+        case 222:
+            return (SDLKey)'\'';
+        default:
+            break;
+    }
+
+    if (cc_embed_json_has_string(payload, "\"code\"", "ArrowLeft")) {
+        return SDLK_LEFT;
+    }
+    if (cc_embed_json_has_string(payload, "\"code\"", "ArrowUp")) {
+        return SDLK_UP;
+    }
+    if (cc_embed_json_has_string(payload, "\"code\"", "ArrowRight")) {
+        return SDLK_RIGHT;
+    }
+    if (cc_embed_json_has_string(payload, "\"code\"", "ArrowDown")) {
+        return SDLK_DOWN;
+    }
+
+    return SDLK_UNKNOWN;
+}
+
+static uint32_t cc_embed_get_pixel(const uint8_t *row, int x, const SDL_PixelFormat *format)
+{
+    const uint8_t *p = row + (x * format->BytesPerPixel);
+
+    switch (format->BytesPerPixel) {
+        case 1:
+            return *p;
+        case 2:
+            return *(const uint16_t *)p;
+        case 3:
+#if SDL_BYTEORDER == SDL_BIG_ENDIAN
+            return p[0] << 16 | p[1] << 8 | p[2];
+#else
+            return p[0] | p[1] << 8 | p[2] << 16;
+#endif
+        case 4:
+            return *(const uint32_t *)p;
+        default:
+            return 0;
+    }
+}
+
+static int cc_embed_write_binary_frame(uint32_t frame_id,
+                                       uint64_t timestamp_ms,
+                                       uint16_t width,
+                                       uint16_t height,
+                                       const uint8_t *payload,
+                                       size_t payload_length)
+{
+    uint8_t header[CC_EMBED_BINARY_HEADER_BYTES];
+    size_t frame_length = sizeof(header) + payload_length;
+    cc_embed_write_binary_frame_header(header,
+                                       frame_id,
+                                       timestamp_ms,
+                                       width,
+                                       height,
+                                       (uint32_t)payload_length);
+    if (cc_embed_should_use_frame_socket()) {
+        int result;
+        if (cc_embed_frame_socket == CC_INVALID_SOCKET) { return 0; }
+        result = cc_frame_writer_flush(&cc_embed_frame_writer, cc_embed_frame_socket);
+        if (result == 0) { return 0; }
+        if (result < 0) {
+            cc_embed_close_frame_socket();
+            cc_embed_emit_status("error", "Could not write embedded frame socket.");
+            return 0;
+        }
+        if (!cc_embed_frame_socket_accepts_frame(frame_length)) { return 0; }
+        result = cc_frame_writer_queue(&cc_embed_frame_writer, cc_embed_frame_socket,
+                                       header, sizeof(header), payload, payload_length);
+        if (result < 0) {
+            cc_embed_close_frame_socket();
+            cc_embed_emit_status("error", "Could not queue embedded frame socket.");
+            return 0;
+        }
+        return 1; /* Accepted, possibly still draining on later SDL ticks. */
+    }
+    if (!cc_embed_write_frame_bytes(header, sizeof(header))) {
+        return 0;
+    }
+    if (!cc_embed_write_frame_bytes(payload, payload_length)) {
+        return 0;
+    }
+    if (!cc_embed_should_use_frame_socket()) {
+        fflush(stdout);
+    }
+    return 1;
+}
+
+static void cc_embed_write_binary_frame_header(uint8_t *header,
+                                               uint32_t frame_id,
+                                               uint64_t timestamp_ms,
+                                               uint16_t width,
+                                               uint16_t height,
+                                               uint32_t payload_length)
+{
+    memcpy(header, CC_EMBED_BINARY_MAGIC, 4);
+    header[4] = CC_EMBED_BINARY_FRAME_TYPE_RGBA8888;
+    header[5] = CC_EMBED_BINARY_PIXEL_FORMAT_RGBA8888;
+    cc_embed_write_u16_le(header + 6, CC_EMBED_BINARY_HEADER_BYTES);
+    cc_embed_write_u32_le(header + 8, payload_length);
+    cc_embed_write_u32_le(header + 12, frame_id);
+    cc_embed_write_u64_le(header + 16, timestamp_ms);
+    cc_embed_write_u16_le(header + 24, width);
+    cc_embed_write_u16_le(header + 26, height);
+    cc_embed_write_u32_le(header + 28, 0);
+}
+
+static int cc_embed_write_frame_bytes(const void *buffer, size_t length)
+{
+    if (fwrite(buffer, 1, length, stdout) != length) {
+        cc_embed_emit_status("error", "Could not write embedded frame stream.");
+        return 0;
+    }
+    return 1;
+}
+
+static int cc_embed_frame_socket_accepts_frame(size_t frame_length)
+{
+#ifndef WINDOWS_COMPILE
+#ifdef SO_NWRITE
+    int pending_bytes = 0;
+    socklen_t pending_length = sizeof(pending_bytes);
+    if (!cc_embed_should_use_frame_socket()) {
+        return 1;
+    }
+    if (cc_embed_frame_socket == CC_INVALID_SOCKET) {
+        return 0;
+    }
+    if (getsockopt(cc_embed_frame_socket,
+                   SOL_SOCKET,
+                   SO_NWRITE,
+                   &pending_bytes,
+                   &pending_length) == 0) {
+        size_t pending = pending_bytes > 0 ? (size_t)pending_bytes : 0;
+        if (pending > CC_EMBED_FRAME_SOCKET_BACKLOG_LIMIT_BYTES) {
+            return 0;
+        }
+        if (pending + frame_length > CC_EMBED_FRAME_SOCKET_SEND_BUFFER_BYTES) {
+            return 0;
+        }
+    }
+#else
+    (void)frame_length;
+#endif
+#else
+    (void)frame_length;
+#endif
+    return 1;
+}
+
+static void cc_embed_write_u16_le(uint8_t *target, uint16_t value)
+{
+    target[0] = (uint8_t)(value & 0xff);
+    target[1] = (uint8_t)((value >> 8) & 0xff);
+}
+
+static void cc_embed_write_u32_le(uint8_t *target, uint32_t value)
+{
+    cc_embed_write_u16_le(target, (uint16_t)(value & 0xffff));
+    cc_embed_write_u16_le(target + 2, (uint16_t)((value >> 16) & 0xffff));
+}
+
+static void cc_embed_write_u64_le(uint8_t *target, uint64_t value)
+{
+    cc_embed_write_u32_le(target, (uint32_t)(value & 0xffffffffu));
+    cc_embed_write_u32_le(target + 4, (uint32_t)((value >> 32) & 0xffffffffu));
+}
diff --git a/src/arch/sdl/cc_frame_writer.h b/src/arch/sdl/cc_frame_writer.h
new file mode 100644
--- /dev/null
+++ b/src/arch/sdl/cc_frame_writer.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef VICE_CC_FRAME_WRITER_H
+#define VICE_CC_FRAME_WRITER_H
+#include "cc_socket.h"
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct cc_frame_writer_s {
+    uint8_t *data;
+    size_t length;
+    size_t offset;
+} cc_frame_writer_t;
+
+/* 1: complete, 0: pending (drop new frames), -1: error. One owned record only. */
+int cc_frame_writer_flush(cc_frame_writer_t *writer, cc_socket_t fd);
+int cc_frame_writer_queue(cc_frame_writer_t *writer, cc_socket_t fd,
+                         const void *header, size_t header_length,
+                         const void *payload, size_t payload_length);
+void cc_frame_writer_reset(cc_frame_writer_t *writer);
+#endif
diff --git a/src/arch/sdl/cc_frame_writer.c b/src/arch/sdl/cc_frame_writer.c
new file mode 100644
--- /dev/null
+++ b/src/arch/sdl/cc_frame_writer.c
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc_frame_writer.h"
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+void cc_frame_writer_reset(cc_frame_writer_t *writer)
+{
+    free(writer->data);
+    writer->data = NULL;
+    writer->length = 0;
+    writer->offset = 0;
+}
+
+int cc_frame_writer_flush(cc_frame_writer_t *writer, cc_socket_t fd)
+{
+    while (writer->offset < writer->length) {
+#ifdef _WIN32
+        int written = send(fd, (const char *)writer->data + writer->offset,
+                           (int)(writer->length - writer->offset), 0);
+        if (written == SOCKET_ERROR) {
+            int error = WSAGetLastError();
+            if (error == WSAEINTR) { continue; }
+            if (error == WSAEWOULDBLOCK) { return 0; }
+            return -1;
+        }
+#else
+        ssize_t written;
+#ifdef MSG_NOSIGNAL
+        written = send(fd, writer->data + writer->offset,
+                       writer->length - writer->offset, MSG_NOSIGNAL);
+#else
+        written = send(fd, writer->data + writer->offset,
+                       writer->length - writer->offset, 0);
+#endif
+        if (written < 0 && errno == EINTR) {
+            continue;
+        }
+        if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            return 0;
+        }
+#endif
+        if (written <= 0) {
+            if (written == 0) { errno = EPIPE; }
+            return -1;
+        }
+        writer->offset += (size_t)written;
+    }
+    cc_frame_writer_reset(writer);
+    return 1;
+}
+
+int cc_frame_writer_queue(cc_frame_writer_t *writer, cc_socket_t fd,
+                         const void *header, size_t header_length,
+                         const void *payload, size_t payload_length)
+{
+    int flushed = cc_frame_writer_flush(writer, fd);
+    if (flushed != 1) { return flushed; }
+    if (payload_length > SIZE_MAX - header_length) {
+        errno = EOVERFLOW;
+        return -1;
+    }
+    writer->length = header_length + payload_length;
+    if (writer->length == 0) { return 1; }
+    writer->data = malloc(writer->length);
+    if (!writer->data) {
+        writer->length = 0;
+        return -1;
+    }
+    memcpy(writer->data, header, header_length);
+    memcpy(writer->data + header_length, payload, payload_length);
+    return cc_frame_writer_flush(writer, fd);
+}
