TITLE "Bouncing Balls"
AUTHOR "Commodore Commander"
TEMPO 120
SYSTEM PAL

INSTR lead WAVE=PULSE ADSR=0,4,9,3 PW=$0800
INSTR bass WAVE=TRI ADSR=0,6,8,3

VOICE 1 lead: O5 C8 E8 G8 E8 A8 G8 E8 C8 D8 F8 A8 F8 G8 E8 D8 C8
VOICE 2 bass: O3 C4 G4 A4 F4 C4 G4 F4 G4

TUNE 2 {
  TITLE "Wall hit"
  TEMPO 120
  SYSTEM PAL

  EFFECT WallHit {
    VOICE 3
    LENGTH 5 TICKS
    WAVE=NOISE
    ADSR=0,3,8,2
    GATE=ON
    FREQ=$3800
    GATE=OFF @3
  }
}
