{
  "name": "@commodore-commander/debug-adapter",
  "private": true,
  "version": "0.1.0",
  "description": "TypeScript DAP adapter for Commodore Commander VICE debugging.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "cc-vice-debug-adapter": "lib/vice-debug-adapter.js"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./adapter": {
      "types": "./lib/vice-debug-adapter.d.ts",
      "require": "./lib/vice-debug-adapter.js",
      "default": "./lib/vice-debug-adapter.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf lib",
    "test": "npm run build && node --test lib/test/*.test.js",
    "test:e2e:vice": "npm run build && node --test lib/test/e2e/*.e2e.test.js"
  },
  "dependencies": {
    "@vscode/debugprotocol": "^1.68.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0"
  }
}
